<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <LangVersion>latest</LangVersion>
        <!--XML Comments for OpenAPI-->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
        <!--End of XML Comments for OpenAPI-->
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\identity\Tooiyoo.Identity.Contracts\Tooiyoo.Identity.Contracts.csproj" />
        <ProjectReference Include="..\..\Tooiyoo.Common\Tooiyoo.Common.csproj" />
    </ItemGroup>

</Project>
