meta {
  name: set-profile-phone-number
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/profiles/{{dynamicProfileId}}/setPhoneNumber
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{$oauth2.google-credentials.id_token}}
}

body:json {
  {
    "phoneNumber": "+34644000000"
  }
}

vars:pre-request {
  dynamicIdentityId: 123e4567-e89b-12d3-a456-426614174000
}

settings {
  encodeUrl: true
  timeout: 0
}
