meta {
  name: retrieve-profiles
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/profiles?pageNumber=1&pageSize=5
  body: none
  auth: none
}

params:query {
  pageNumber: 1
  pageSize: 5
}

headers {
  Authorization: Bearer {{$oauth2.google-credentials.id_token}}
}

vars:pre-request {
  dynamicIdentityId: 123e4567-e89b-12d3-a456-426614174000
}

settings {
  encodeUrl: true
  timeout: 0
}
