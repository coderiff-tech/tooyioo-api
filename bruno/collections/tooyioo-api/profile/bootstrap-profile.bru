meta {
  name: bootstrap-profile
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/profiles/bootstrap
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{$oauth2.google-credentials.id_token}}
}

body:json {
  {
    "externalIdProvider": "Google"
  }
}

script:post-response {
  bru.setVar("dynamicProfileId", res.body.id);
}

settings {
  encodeUrl: true
  timeout: 0
}
