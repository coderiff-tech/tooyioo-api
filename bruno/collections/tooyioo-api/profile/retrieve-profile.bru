meta {
  name: retrieve-profile
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/profiles/{{dynamicProfileId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{$oauth2.google-credentials.id_token}}
}

vars:pre-request {
  dynamicIdentityId: 123e4567-e89b-12d3-a456-426614174000
}

settings {
  encodeUrl: true
  timeout: 0
}
